{
  "name": "@walls/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "admin:create": "tsx --env-file-if-exists=../../.env src/scripts/create-super-admin.ts",
    "demo:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-demo.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@walls/database": "workspace:*",
    "@walls/shared": "workspace:*",
    "@walls/ui": "workspace:*",
    "@walls/validation": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
