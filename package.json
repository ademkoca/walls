{
  "name": "walls",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @walls/e2e test:e2e",
    "lint": "pnpm --filter @walls/web typegen && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:generate": "node scripts/generate-logo-variants.ts && node scripts/generate-brand-assets.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @walls/database db:generate",
    "db:migrate": "pnpm --filter @walls/database db:migrate",
    "db:studio": "pnpm --filter @walls/database db:studio",
    "admin:create": "pnpm --filter @walls/api admin:create",
    "demo:seed": "pnpm --filter @walls/api demo:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/montserrat": "^5.3.0",
    "@next/eslint-plugin-next": "^16.4.2",
    "@types/fontkit": "^2.0.9",
    "@types/node": "catalog:",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1"
  }
}
