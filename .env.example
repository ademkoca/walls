# Walls environment configuration.
# Copy to `.env` in the repository root; both apps/api and apps/web load it in development.
# In production, set these in the hosting dashboards (Render for the API, Netlify for the web app).
# Never commit real values.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
# Port the Express API listens on.
API_PORT=4000

# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# PostgreSQL connection string. Local value matches docker-compose.yml.
# Production: the Supabase connection string.
DATABASE_URL=postgres://walls:walls@localhost:5432/walls

# Separate database for integration tests; it is wiped and re-migrated on every run.
# Local value matches docker-compose.yml.
TEST_DATABASE_URL=postgres://walls:walls@localhost:5432/walls_test

# Key for hashing session and email-link tokens (HMAC-SHA-256). Required, at least 32
# characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out and
# invalidates all emailed links.
SESSION_SECRET=

# Public origin of the web app. State-changing API requests must come from this origin
# (CSRF protection), and links in emails point to it.
WEB_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the API (e.g. Render, plus the Netlify /api proxy),
# used to find the real client IP for rate limiting. 0 when calling the API directly.
TRUST_PROXY_HOPS=0

# Auth requests (register, login, password reset, …) allowed per client IP every 15 minutes.
AUTH_RATE_LIMIT_PER_IP=30

# Resend API key for transactional email. Required in production. Leave empty in
# development to print emails (including their links) to the API console instead.
RESEND_API_KEY=
# Sender address for transactional email.
EMAIL_FROM="Walls <no-reply@walls.rs>"

# Cloudinary credentials for listing images, profile pictures and agent proof files
# (stored as private, `authenticated` files).
# Set all three or none. Required in production. Without them, development stores
# uploads on the local disk in LOCAL_MEDIA_DIR and the API serves them itself.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development only: upload directory when Cloudinary is not configured, relative to the
# API's working directory (apps/api). Gitignored.
LOCAL_MEDIA_DIR=.media
# Development only: private documents (agent applications' proof files) without Cloudinary.
# Never served directly; the API streams them to administrators. Gitignored.
LOCAL_PRIVATE_FILES_DIR=.private-files

# API key for the EUR/RSD exchange-rate provider. (Used from Phase 8.)
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Internal URL of the API. The web app proxies /api/* to it so auth cookies stay
# first-party. Required for production builds.
API_INTERNAL_URL=http://localhost:4000

# Canonical public URL of the site, used for SEO metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map tiles (OpenStreetMap-based). Defaults to the public OSM tile server, which is fine for
# development but forbids heavy use: set an OSM-based tile host for production.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
