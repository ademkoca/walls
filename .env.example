# Walls environment configuration.
# Copy to `.env` in the repository root; both apps/api and apps/web load it in development.
# In production, set these in the hosting dashboards (Render for the API, Netlify for the web app).
# Never commit real values.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
# Port the Express API listens on.
API_PORT=4000

# Log level: fatal | error | warn | info | debug | trace. (Used from Phase 3.)
LOG_LEVEL=info

# PostgreSQL connection string. Local value matches docker-compose.yml.
# Production: the Supabase connection string. (Used from Phase 2.)
DATABASE_URL=postgres://walls:walls@localhost:5432/walls

# Separate database for integration tests; it is wiped and re-migrated on every run.
# Local value matches docker-compose.yml.
TEST_DATABASE_URL=postgres://walls:walls@localhost:5432/walls_test

# Secret used to sign session/CSRF values. At least 32 random bytes, e.g.
# `openssl rand -base64 48`. (Used from Phase 3.)
SESSION_SECRET=

# Public origin of the web app. Used for CORS/CSRF origin checks and links in emails.
WEB_ORIGIN=http://localhost:3000

# Resend API key for transactional email. Leave empty in development to write
# emails to the local outbox instead of sending them. (Used from Phase 3.)
RESEND_API_KEY=
# Sender address for transactional email. (Used from Phase 3.)
EMAIL_FROM="Walls <no-reply@walls.rs>"

# Cloudinary credentials for listing media and agent proof files. (Used from Phase 5.)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# API key for the EUR/RSD exchange-rate provider. (Used from Phase 8.)
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Internal URL of the API. The web app proxies /api/* to it so auth cookies stay
# first-party. (Used from Phase 3.)
API_INTERNAL_URL=http://localhost:4000

# Canonical public URL of the site, used for SEO metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
