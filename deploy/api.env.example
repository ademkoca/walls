# /opt/walls/<environment>/api.env on the VPS: one environment's API settings (mode 600, owned
# by deploy). Production and staging never share a database, Cloudinary account or session
# secret (README.md, "Environment settings").
# Meanings: .env.example at the repository root. NODE_ENV, API_PORT and TRUST_PROXY_HOPS
# are set in compose.yaml.

# Supabase session pooler connection string, ending in ?sslmode=require.
DATABASE_URL=
# Same value as before moving hosts, or everyone is signed out and emailed links stop working.
SESSION_SECRET=
# The site's public origin: https://walls.rs (production) or https://preview.walls.rs (staging).
WEB_ORIGIN=
RESEND_API_KEY=
# Staging: "Walls Preview <no-reply@walls.rs>", so its emails stand out.
EMAIL_FROM="Walls <no-reply@walls.rs>"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXCHANGE_RATE_PROVIDER=nbs
