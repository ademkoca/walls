# Caddy for every Walls environment (caddy/compose.yaml). PRODUCTION_HOST, STAGING_HOST and
# ACME_EMAIL come from /opt/walls/caddy/.env. Caddy obtains and renews the HTTPS certificates
# itself, once a host's DNS points at this server.
{
	email {$ACME_EMAIL}
}

# One environment: its web app on port {args[0]}, its API on {args[1]} (the WEB_PORT and
# API_PORT in that environment's .env).
(walls) {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	# The API directly, not through Next.js, so uploads keep the API's own limits
	# (listing photos up to 15 MB, agent proof files up to 5 × 10 MB).
	handle /api/* {
		request_body {
			max_size 60MB
		}
		reverse_proxy 127.0.0.1:{args[1]}
	}

	handle {
		reverse_proxy 127.0.0.1:{args[0]}
	}
}

{$PRODUCTION_HOST} {
	import walls 3000 4000
}

www.{$PRODUCTION_HOST} {
	redir https://{$PRODUCTION_HOST}{uri} permanent
}

{$STAGING_HOST} {
	import walls 3001 4001
}
