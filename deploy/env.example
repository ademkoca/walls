# /opt/walls/.env on the VPS: values for deploy/compose.yaml (not secret).
# The API's secrets go in /opt/walls/api.env (see api.env.example).

# The public host name Caddy serves and obtains a certificate for.
SITE_HOST=preview.walls.rs
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=
IMAGE_PREFIX=ghcr.io/ademkoca
# Set by deploy.sh to the running version (commit SHA).
WALLS_VERSION=
