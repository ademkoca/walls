# /opt/walls/<environment>/.env on the VPS: values for deploy/compose.yaml (not secret).
# The API's secrets go in api.env next to it (see api.env.example).

# "production" or "staging": the Compose project (walls-<environment>) and the web image tag.
WALLS_ENVIRONMENT=production
# Ports on 127.0.0.1 that Caddy sends this environment's traffic to (caddy/Caddyfile):
# production 3000 and 4000, staging 3001 and 4001.
WEB_PORT=3000
API_PORT=4000
# Memory limits: production 1g and 768m; staging 512m and 384m, so it can't starve production.
WEB_MEMORY=1g
API_MEMORY=768m
IMAGE_PREFIX=ghcr.io/ademkoca
# Set by deploy.sh to the running version (commit SHA).
WALLS_VERSION=
